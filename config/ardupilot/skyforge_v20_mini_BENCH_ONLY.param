# SKYFORGE V20 MINI - BENCH-ONLY PORT MAP for ArduPilot Plane (target SpeedyBeeF405WING)
#
# NOT A FLIGHT TUNE, FAILSAFE PACKAGE, SERVO CALIBRATION OR MODE-SWITCH CONFIG. It assigns ports, the motor
# protocol and the current limits the 4S2P Li-ion pack needs so props-off bring-up can start. Reboot after
# Q_ENABLE, then re-load. Generated by tools/v20/bom.py from analysis/v20_sizing.json.
Q_ENABLE,1
Q_FRAME_CLASS,1
Q_FRAME_TYPE,1
# DShot300 to the 4-in-1 ESC (BLHeli_32)
Q_M_PWM_TYPE,5
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
SERVO5_FUNCTION,77
SERVO6_FUNCTION,78
SERVO7_FUNCTION,77
SERVO8_FUNCTION,78
SERVO9_FUNCTION,21
# bottom louvres / exit vanes: driven by a Lua script (open in VTOL modes, shut in fixed-wing modes, angled aft by the
# forward-speed demand in transition, differential for yaw) - not written yet, an open item; with no script the
# outputs hold their trim - set the trim to OPEN before any hover test
SERVO10_FUNCTION,94
SERVO11_FUNCTION,70
SERVO12_FUNCTION,95
SERIAL1_PROTOCOL,23
SERIAL3_PROTOCOL,5
ARSPD_TYPE,1
# --- battery: 4S2P Molicel P45B class (9 Ah, 90 A continuous) ---
BATT_MONITOR,4
BATT_CAPACITY,9000
BATT_ARM_VOLT,14.8
BATT_LOW_VOLT,13.2
BATT_CRT_VOLT,12.4
# lift motors back off above this total current (hover ~28 A); the EDF runs to full throttle
Q_M_BAT_CURR_MAX,76
THR_MAX,100
# --- speeds from the model (calibrate in flight test): wing-borne minimum ~11.7 m/s
# (trimmed CL 0.51 at 14 deg, no vortex lift credited). ArduPlane 4.5+ names; older: ARSPD_FBW_MIN/MAX
AIRSPEED_MIN,16
AIRSPEED_CRUISE,18
AIRSPEED_MAX,22
Q_ASSIST_SPEED,15
